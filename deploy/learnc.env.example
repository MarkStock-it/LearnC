# LearnC production environment (DCISM host, Debian 12, shared university server)
# Installed as ~/learnc-app/backend/.env on the server. Never commit the real file.

NODE_ENV=production
PORT=20341
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# The host's Postgres/MariaDB accounts are provisioned per-app and none match
# this app's schema needs; SQLite keeps the deployment self-contained.
DB_CLIENT=better-sqlite3
DB_FILE=/data/users/s25103705/learnc-app/data/c-practice.sqlite

# --- Queue ----------------------------------------------------------------
QUEUE_DRIVER=inline
QUEUE_CONCURRENCY=2
EXECUTOR_CONCURRENCY=1

# --- Sandbox ---------------------------------------------------------------
# Docker daemon is not reachable for this user; the user-namespace sandbox
# gives mount+PID+network isolation without root.
EXECUTOR_MODE=unshare
C_COMPILER=/usr/bin/gcc

# --- AI problem generation -------------------------------------------------
# llama.cpp OpenAI-compatible server already listening on the host (127.0.0.1:11434,
# Llama-3.2-3B-Instruct). Malformed generations fall back to the curated bank.
AI_PROVIDER=openai-compat
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=Llama-3.2-3B-Instruct-Q4_K_M
AI_MAX_ATTEMPTS=3

# --- HTTP -------------------------------------------------------------------
# Generate with: openssl rand -hex 16
ADMIN_TOKEN=CHANGE-ME
MAX_CODE_BYTES=65536
MAX_BODY_SIZE=256kb
