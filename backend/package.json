{
  "name": "c-practice-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API, job queue and code-execution sandbox for the C programming practice platform",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:rollback": "tsx src/scripts/rollback.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "worker": "tsx src/scripts/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "better-sqlite3": "^13.0.3",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
