[TEMPLATE]
# ---------------------------------------------------------------------------
# Database: better-sqlite3 for zero-infra dev, pg for Postgres, mysql for a
# managed MariaDB/MySQL server (host/port/user/password/database are used then).
# ---------------------------------------------------------------------------
DB_CLIENT=better-sqlite3          # better-sqlite3 | pg | mysql
DB_FILE=../data/c-practice.sqlite # used when DB_CLIENT=better-sqlite3
DATABASE_URL=postgres://postgres:postgres@localhost:5432/c_practice
DB_HOST=127.0.0.1                 # used when DB_CLIENT=mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=c_practice

# ---------------------------------------------------------------------------
# Queue (plan §2.2: Bull + Redis in production, in-process for development)
# ---------------------------------------------------------------------------
QUEUE_DRIVER=inline               # inline | bull
REDIS_URL=redis://127.0.0.1:6379
QUEUE_CONCURRENCY=4
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=750

# ---------------------------------------------------------------------------
# Sandbox (plan §6.1). `auto` prefers Docker, then the user-namespace `unshare`
# sandbox (Linux), then the host compiler. The local executor gives NO isolation
# and is refused when NODE_ENV=production.
# ---------------------------------------------------------------------------
EXECUTOR_MODE=auto                # auto | docker | unshare | local
EXECUTOR_DOCKER_IMAGE=c-practice-runner:latest
EXECUTOR_TIME_LIMIT_MS=5000       # upper bound; each problem sets its own limit
EXECUTOR_COMPILE_TIMEOUT_MS=20000
EXECUTOR_MEMORY_MB=256
EXECUTOR_PIDS_LIMIT=64            # blocks fork bombs
EXECUTOR_CPU_LIMIT=1
EXECUTOR_MAX_OUTPUT_BYTES=65536
EXECUTOR_CONCURRENCY=2
# C_COMPILER=/usr/bin/gcc                   # optional override for the sandbox

# ---------------------------------------------------------------------------
# AI problem generation (plan §4). Without a provider the curated offline bank
# is used, so the platform is fully functional with no external services.
# ---------------------------------------------------------------------------
AI_PROVIDER=offline               # anthropic | offline | openai-compat
ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022
# OpenAI-compatible endpoint (Ollama: http://127.0.0.1:11435/v1, llama.cpp servers).
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_TIMEOUT_MS=120000              # hard per-call timeout; then fall back to the offline bank
AI_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
PORT=4000
LOG_LEVEL=info
ADMIN_TOKEN=                      # required to enable /api/admin/generate-problem
MAX_CODE_BYTES=65536
MAX_BODY_SIZE=256kb
